# Copy this file to .env and fill in real values, then run:
#   php artisan key:generate

APP_NAME="Omali Cravings"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
# Leave as sqlite for a zero-setup local install (php artisan migrate will
# create database/database.sqlite for you). On WhoGoHost/cPanel, create a
# MySQL database + user from cPanel's "MySQL Databases" tool and switch
# these to DB_CONNECTION=mysql — see DEPLOY.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# --- Email notifications (sent to the business owner on every paid order) ---
# Easiest option: a Gmail address + an "App Password" — see README. Leave
# MAIL_HOST/MAIL_USERNAME blank (the "log" mailer below) and order emails
# just get written to storage/logs/laravel.log instead of failing — handy
# while you're still setting this up.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="Omali Cravings Orders"
# Where the "new order" notification goes — defaults to MAIL_FROM_ADDRESS if left blank.
NOTIFY_EMAIL=owner-inbox@example.com

# --- CORS ---
# Only matters if you run the frontend as its own `npm run dev` process
# against this API. Once merged/deployed as one app, requests are
# same-origin and this is unused.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Paystack (https://dashboard.paystack.com/#/settings/developer) ---
# Use the TEST keys while developing, switch to LIVE keys when you go live.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (https://dashboard.stripe.com/test/apikeys) — second payment option ---
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From the Stripe CLI (`stripe listen`) while testing locally, or the
# dashboard's webhook settings once deployed.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Store settings ---
CURRENCY=NGN
CURRENCY_SYMBOL=₦
# Stripe accounts don't all support every currency Paystack does (e.g. NGN) —
# override this if Stripe rejects the default.
STRIPE_CURRENCY=NGN
# Flat delivery fee added at checkout, in the currency above (whole units).
DELIVERY_FEE=1500

# --- Site ---
# Used to build Stripe's redirect-back URLs after payment. Once the
# frontend is merged in (the default here), this should just match APP_URL.
SITE_URL="${APP_URL}"
